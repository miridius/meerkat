<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" type="image/x-icon" />
    <.live_title default="meerkat">
      {assigns[:page_title]}
    </.live_title>
    <%!-- If a Vite dev-server watcher is ever enabled, pass a to_url
          that maps paths to the dev-server origin (see the
          phoenix_vite docs), or /@vite/client 404s against Phoenix
          and the page loads with no JS. --%>
    <PhoenixVite.Components.assets
      names={["js/app.js"]}
      manifest={{:meerkat, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(MeerkatWeb.Endpoint)}
    />
    <%!-- Imported CSS (live_svelte component imports of
          @git-diff-view/svelte/styles/diff-view.css) lands as a
          sibling chunk in the manifest under the `css` field — the
          PhoenixVite.Components.assets helper auto-includes them. --%>
  </head>
  <body>
    {@inner_content}
    <%!-- The ToolbarHeight hook mounts only once LiveSocket connects,
          and app.js restores the scroll position across a reload, so
          without this a reload deep inside a file paints the header
          behind the toolbar. --%>
    <script>
      (function () {
        var toolbar = document.querySelector(".diff-toolbar");
        if (toolbar) {
          document.documentElement.style.setProperty(
            "--toolbar-h",
            Math.round(toolbar.getBoundingClientRect().height) + "px"
          );
        }
      })();
    </script>
  </body>
</html>
