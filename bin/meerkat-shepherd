#!/usr/bin/env bash
# Prod shepherd for meerkat. The installed `meerkat` wrapper sets
# MEERKAT_CURRENT_LINK (the install's `current` symlink) and execs this.
# It runs the release BEAM in a loop on a deterministic port. The BEAM
# self-halts with code 75 when its VersionWatcher sees `current` flip to
# a newer version; the shepherd re-resolves `current` and respawns on
# the SAME port, so the browser's LiveView reconnects to the new version
# and ReviewServer reloads in-progress comments from the snapshot.
#
# What git (the blocked `git commit`) waits on is this shepherd, so the
# BEAM can be torn down and respawned underneath it without the commit
# ever ending. A crash (exit 2) is retried once (state restored from the
# in-progress snapshot) before the commit aborts; a clean decision (0/1)
# or a second crash propagates to git so the hook proceeds (0) or aborts.
#
# Shares the deterministic-port / signal-forwarding / open-marker
# approach with the dev shepherd `bin/meerkat-beam`; a follow-up could
# factor the common bits into a sourced lib.

set -uo pipefail

CURRENT_LINK="${MEERKAT_CURRENT_LINK:?meerkat-shepherd: MEERKAT_CURRENT_LINK not set}"
export MEERKAT_PWD="${MEERKAT_PWD:-$PWD}"
export MEERKAT_CURRENT_LINK="$CURRENT_LINK"

RESTART_EXIT_CODE=75

# Deterministic port from (cwd, args) so a respawn — and a fresh
# git-commit re-invocation of the same review — reuse the same port and
# the browser tab reconnects without re-navigation. Same formula and
# 40000-59999 range as bin/meerkat-beam.
if [[ -n "${MEERKAT_PORT:-}" ]]; then
  stable_port="$MEERKAT_PORT"
else
  hex8=$(printf '%s' "${MEERKAT_PWD}:$*" | shasum -a 256 | head -c 8)
  stable_port=$(( 16#${hex8} % 20000 + 40000 ))
fi

# Replace any --port in the args with the stable one, else append it.
rewrite_port_arg() {
  local new_port="$1"
  shift
  local out=()
  local i=1
  local got_port=false
  while [[ $i -le $# ]]; do
    local arg="${!i}"
    if [[ "$arg" == "--port" ]]; then
      out+=("--port" "$new_port")
      i=$((i + 2))
      got_port=true
    else
      out+=("$arg")
      i=$((i + 1))
    fi
  done
  if [[ "$got_port" == "false" ]]; then
    out+=("--port" "$new_port")
  fi
  printf '%s\n' "${out[@]}"
}

mapfile -t run_args < <(rewrite_port_arg "$stable_port" "$@")

# Browser-open marker: the BEAM opens the review URL only on the first
# iteration that finds the marker empty, so a respawn doesn't spawn a
# duplicate tab (the existing tab just reconnects).
OPEN_MARKER="$(mktemp -t meerkat-opened.XXXXXX)"
export MEERKAT_OPEN_MARKER="$OPEN_MARKER"
trap 'rm -f "$OPEN_MARKER"' EXIT

# Forward TERM/INT/HUP to the running BEAM. Bash never relays signals to
# a foreground child, so without this a killed shepherd orphans a BEAM
# that sits on the deterministic port forever. The BEAM runs as a
# background job + `wait` so this fires immediately.
beam_pid=""
on_signal() {
  local pids="${beam_pid:-$(jobs -p)}"
  if [[ -n "$pids" ]]; then
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null
    wait $pids 2>/dev/null
  fi
  exit 143
}
trap on_signal TERM INT HUP

crashed=0
while true; do
  RELEASE_DIR="$(readlink "$CURRENT_LINK" 2>/dev/null || true)"
  if [[ -z "$RELEASE_DIR" || ! -x "$RELEASE_DIR/bin/meerkat" ]]; then
    echo "meerkat: no current release at $CURRENT_LINK; re-run scripts/install.sh from the meerkat repo." >&2
    exit 127
  fi

  "$RELEASE_DIR/bin/meerkat" \
    eval "Meerkat.CLI.main(System.argv()) |> System.halt()" "${run_args[@]}" &
  beam_pid=$!
  wait "$beam_pid"
  exit_code=$?
  beam_pid=""

  if [[ "$exit_code" == "$RESTART_EXIT_CODE" ]]; then
    crashed=0
    echo "meerkat: new version live; restarting on port $stable_port..." >&2
    continue
  fi

  # Crash (exit 2): retry once (the in-progress snapshot is restored on
  # the respawn), then abort so the commit fails closed.
  if [[ "$exit_code" == "2" && "$crashed" == "0" ]]; then
    crashed=1
    echo "meerkat: BEAM crashed (exit 2); respawning once before aborting..." >&2
    continue
  fi

  exit "$exit_code"
done
