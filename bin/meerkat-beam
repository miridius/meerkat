#!/usr/bin/env bash
# Dev launcher: runs meerkat from this checkout under Mix. Wraps `mix
# run` in a shepherd loop so the BEAM can self-halt with exit code 75
# to restart onto a new version (only when `MEERKAT_CURRENT_LINK` is
# set, as the e2e restart test does) and the launcher respawns it,
# preferring the port it bound. The user's browser sees a brief
# WebSocket drop + LV auto-reconnects to the new BEAM;
# `ReviewServer.init` reloads in-progress comments via
# `Meerkat.Persistence`.
#
# Tests point `MEERKAT_BIN` at this script:
#
#     MEERKAT_BIN=./bin/meerkat-beam bun run test:e2e
#
# cd into the Mix project root so `mix run` works, but capture the
# caller's cwd in $MEERKAT_PWD so `Meerkat.CLI` reads git state
# from the right tree.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ORIG_PWD="$(pwd)"

cd "$ROOT"

export MIX_ENV="${MIX_ENV:-dev}"
export MEERKAT_PWD="$ORIG_PWD"

# Pre-compile guard. Cheap when the build is warm — `find` short-
# circuits on first newer file. A new worktree's build is copied from
# the main checkout after its sources are checked out, so it can look
# newer than sources it was not compiled from; a stamp naming the
# checkout whose launcher last compiled the build makes the first launch in any
# other checkout run `mix compile`, which decides what is stale.
precompile_if_stale() {
  local lock="_build/${MIX_ENV}/lib/meerkat/.mix/compile.elixir"
  local stamp="_build/${MIX_ENV}/.meerkat-root"
  if [[ ! -f "$lock" ]] || [[ "$(cat "$stamp" 2>/dev/null)" != "$ROOT" ]] || \
     [[ -n "$(find lib config mix.exs mix.lock -newer "$lock" -print -quit 2>/dev/null)" ]]; then
    mix compile --no-warnings-as-errors >&2 || return $?
    printf '%s\n' "$ROOT" >"$stamp"
  fi
  return 0
}

# Asset build — same guard.
build_assets_if_stale() {
  local manifest="priv/static/.vite/manifest.json"
  if [[ ! -f "$manifest" ]] || \
     [[ -n "$(find assets/svelte assets/js assets/css assets/ts assets/package.json pnpm-lock.yaml -newer "$manifest" -print -quit 2>/dev/null)" ]]; then
    MIX_BUILD_PATH="$ROOT/_build/${MIX_ENV}" \
      bash -c 'cd assets && bunx vite build' >&2
  fi
}

# The e2e suite's global setup builds once through the same guards
# before its parallel workers each boot this launcher.
if [[ -n "${MEERKAT_BUILD_ONLY:-}" ]]; then
  precompile_if_stale
  build_assets_if_stale
  exit 0
fi

# shellcheck source=bin/meerkat-attach
source "$SCRIPT_DIR/meerkat-attach"

CLI_EVAL="File.cd!(System.get_env(\"MEERKAT_PWD\") || \".\"); $MEERKAT_CLI_HALT"

# `--answers` reads the answers from stdin, and the loop below starts
# the BEAM as a background job, which bash gives /dev/null as stdin.
# So it runs once, through `meerkat_run_once`, which hands the BEAM the
# caller's stdin, with no restart to re-read a stdin already consumed.
for arg in "$@"; do
  if [[ "$arg" == "--answers" || "$arg" == "--answers=true" ]]; then
    if [[ -t 0 ]]; then
      echo "meerkat: --answers reads the answers as JSON on stdin; pipe them in, e.g. meerkat --answers < answers.json" >&2
      exit 64
    fi
    # Without this guard `set -e` kills the script on the compile
    # failure's own status, 1, which is what meerkat exits when it
    # rejects the answers themselves.
    if ! precompile_if_stale; then
      echo "meerkat: the build is broken, so the answers were not stored; fix the compile error above and re-run." >&2
      exit 2
    fi
    meerkat_run_once mix run --no-start --no-compile -e "$CLI_EVAL" -- "$@"
  fi
done

# Run as the caller, which re-runs this script detached, with
# MEERKAT_SERVE_DIR set, to serve the review.
if [[ -z "${MEERKAT_SERVE_DIR:-}" ]]; then
  # The re-run takes the user's repo from its working directory.
  cd "$ORIG_PWD"
  meerkat_attach "$SCRIPT_DIR/meerkat-beam" "$@"
fi

# Explicit --port and --port=N (including --port 0) pass through
# unchanged and leave MEERKAT_PREFERRED_PORT unset. Without an explicit
# port, prefer MEERKAT_PORT (useful for tests/debugging) or hash
# (root,args) to int(shasum256(root:args)[:8]) % 20000 + 40000, with
# root from `meerkat_review_root`. This stable port keeps a fresh
# invocation of the same review, with the same args in the same work
# tree, from any of its directories, on the same port so its browser tab needs
# no re-navigation. The 40000-59999 range is above privileged ports;
# its portion below 49152 is outside macOS's default ephemeral range,
# making OS-allocation collisions rare. If the preferred port is taken,
# the CLI warns and uses an OS-assigned port.
unset MEERKAT_PREFERRED_PORT
explicit_port=false
for arg in "$@"; do
  if [[ "$arg" == "--port" || "$arg" == --port=* ]]; then
    explicit_port=true
  fi
done
if [[ "$explicit_port" == "false" ]]; then
  if [[ -n "${MEERKAT_PORT:-}" ]]; then
    export MEERKAT_PREFERRED_PORT="$MEERKAT_PORT"
  else
    hash_input="$(meerkat_review_root):$*"
    hex8=$(printf '%s' "$hash_input" | shasum -a 256 | head -c 8)
    # Convert lowercase-hex 8 chars → decimal → modulo 20000 + 40000.
    export MEERKAT_PREFERRED_PORT=$(( 16#${hex8} % 20000 + 40000 ))
  fi
fi

# `--no-start` keeps the OTP app stopped so `Meerkat.CLI.main` can
# put_env dynamic config BEFORE the endpoint binds.
RESTART_EXIT_CODE=75

# Set the secret once before the respawn loop, preserving any inherited value.
# Every BEAM can then verify the tab's existing LiveView session token,
# so a restart reconnects in place instead of forcing a full page reload.
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-$(head -c 48 /dev/urandom | base64)}"

# Browser-open marker: a file in the run dir the BEAM stamps the FIRST
# time it successfully calls `open` on the review URL. Subsequent
# shepherd iterations (BEAM exit 75 = restart) see the
# marker and skip the open, so the user's existing tab keeps its
# reconnect instead of getting a duplicate. `open URL` on macOS
# doesn't reliably focus an existing tab when the tab is in another
# Chrome workspace / profile — relying on OS dedupe spammed tabs
# across restarts. We track our own state.
# Not $TMPDIR, which macOS empties of files three days old. The BEAM
# treats "empty" as "browser not yet opened"; after a successful open
# it writes "1".
OPEN_MARKER="$MEERKAT_SERVE_DIR/opened"
: >"$OPEN_MARKER"
export MEERKAT_OPEN_MARKER="$OPEN_MARKER"
# The caller is not this shepherd's parent, so it reads the exit code
# from the serve dir.
trap 'code=$?; rm -f "$OPEN_MARKER"; echo "$code" >"$MEERKAT_SERVE_DIR/exit.tmp" && mv -f "$MEERKAT_SERVE_DIR/exit.tmp" "$MEERKAT_SERVE_DIR/exit"' EXIT

# On TERM/INT/HUP (e2e runner teardown, Ctrl-C wrappers), SIGKILL the
# running BEAM and exit 143.
beam_pid=""
trap meerkat_on_signal TERM INT HUP

while true; do
  if ! precompile_if_stale || ! build_assets_if_stale; then
    echo >&2 "meerkat: the build failed — defaulting to REJECT (commit aborted)."
    exit 2
  fi

  meerkat_restore_run_files

  set +e
  mix run --no-start --no-compile -e "$CLI_EVAL" -- "$@" &
  beam_pid=$!
  wait "$beam_pid"
  exit_code=$(meerkat_decision_code $?)
  beam_pid=""
  # The port file records "<port> <pid>" for the port this BEAM bound.
  # Carry it forward after every exit, including runs using explicit
  # --port 0, so the BEAM after a restart tries it first
  # and the open browser tab can reconnect.
  if [[ -f "$MEERKAT_SERVE_DIR/port" ]]; then
    read -r bound_port _ <"$MEERKAT_SERVE_DIR/port"
    export MEERKAT_PREFERRED_PORT="$bound_port"
    # Remove the exited BEAM's port so callers can't reattach to it
    # while the next BEAM is starting.
    rm -f "$MEERKAT_SERVE_DIR/port"
  fi
  set -e

  if [[ "$exit_code" == "$RESTART_EXIT_CODE" ]]; then
    echo "meerkat: restarting..." >&2
    continue
  fi

  # Every exit other than 75, including crash exit 2, ends the shepherd
  # with that code (see docs/features/cli.md for exit codes).
  exit "$exit_code"
done
