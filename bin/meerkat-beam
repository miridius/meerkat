#!/usr/bin/env -S bun --no-env-file --config=/dev/null
// The dev launcher: see lib/beam.ts. Bun loads no .env or bunfig.toml
// from the reviewed repo, whose variables would reach the BEAM and whose
// preloads would run in the launcher.
import { main } from "./lib/beam.ts";
import { launch } from "./lib/serve.ts";

await launch(main);
