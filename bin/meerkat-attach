# shellcheck shell=bash
#
# The caller half of the meerkat launchers, sourced by `meerkat-shepherd`
# and `meerkat-beam`. `meerkat_attach` starts the review backend
# detached, or finds the one an earlier invocation of the same review
# left running, relays its stderr, and exits with its decision. The
# backend sits outside the caller's process tree, so killing the caller
# leaves the review running for the next invocation to reattach to.
# `meerkat_restore_run_files`, at the end, is the shepherd's.
#
# Each run has its own <runs>/<key>.<uuid> directory; <runs>/<key> is
# a symlink naming the current run by its relative sibling name,
# <key>.<uuid>. An attached caller keeps its own run dir, so a rerun
# cannot replace the exit status it reads. A real dir at <runs>/<key>
# belongs to an older meerkat; callers still attach to it because an
# orphaned review lives until reattached and can outlast an upgrade.
#
# A backend's run dir holds `pid` (its shepherd), `caller` (the pid of
# the caller waiting on it: a takeover overwrites it, and a refused one
# restores it), `token`, `log` (its
# stderr), `port` ("<port> <BEAM pid>" while a BEAM serves), `served`
# (once a BEAM has announced the review), `opened` (the browser-open
# marker), `index` (a held temporary index, if any) and, once it has
# exited, `exit`. The attach stream's
# frames are documented in `MeerkatWeb.AttachController`.

meerkat_attach() {
  local self="$1"
  shift
  set +e

  local key runs
  # Keyed like the port, so a rerun of the same review finds its run dir.
  key=$(printf '%s' "${MEERKAT_PWD}:$*" | shasum -a 256 | head -c 16)
  # Not $TMPDIR: macOS deletes its files once they are three days old,
  # and a review can wait longer than that.
  runs="${MEERKAT_RUNS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/meerkat/runs}"
  mkdir -p "$runs"

  _MA_LINK="$runs/$key"
  # Set before the traps: a signal can arrive before a run dir is found.
  _MA_DIR=""
  _MA_RUN="$(uuidgen)"
  _MA_OWNED=0
  # Whether this caller started its run or has heard from its server.
  _MA_HELD=0
  _MA_PREV_CALLER=""
  _MA_OFFSET=0
  _MA_QUIET=0
  _MA_PID_WAIT=0
  _MA_TICK=0
  _ma_record_ancestors
  trap '_ma_stopped TERM' TERM
  trap '_ma_stopped INT' INT
  trap '_ma_stopped HUP' HUP
  _ma_reap_finished

  while true; do
    ((_MA_OWNED)) || _ma_find_server || continue

    if [[ -f "$_MA_DIR/exit" ]]; then
      if ((_MA_OWNED && !_MA_HELD)); then
        # A reattach whose server exited before it heard from it: that
        # exit code was not this invocation's. Hand the run back to the
        # caller it replaced, or remove it if none, and start afresh, as a
        # new invocation would.
        _ma_restore_caller
        if [[ "$(cat "$_MA_DIR/caller" 2>/dev/null)" == "$$" ]]; then
          _ma_must _ma_remove_run
        fi
        _MA_OWNED=0
        continue
      fi
      if ((_MA_OWNED)); then
        _ma_relay_log
        local code
        code="$(<"$_MA_DIR/exit")"
        _ma_remove_run
        exit "$code"
      fi
      # Its exit code is for the caller attached to it, which removes it.
      if ! _ma_caller_alive "$_MA_DIR"; then
        # No live caller is recorded: remove its finished run now.
        _ma_must _ma_remove_run
      elif [[ "$_MA_DIR" != "$_MA_LINK" ]] || _ma_exit_stale "$_MA_DIR"; then
        _ma_must _ma_retire "$_MA_DIR"
      else
        sleep 0.2
      fi
      continue
    fi

    if [[ ! -d "$_MA_DIR" ]]; then
      if ((_MA_OWNED && !_MA_HELD)); then
        # A reattach that never heard from its server, whose run another
        # invocation has since removed (the caller before it, done with
        # it, or one that found the server dead): start afresh, as a new
        # invocation would.
        _MA_OWNED=0
        continue
      fi
      if ((_MA_OWNED)); then
        # Another invocation removed our run dir, after its server died or
        # over a minute after it finished (for example, while the laptop
        # slept). We cannot read our own run's exit code, so fail closed
        # instead of starting a new server.
        echo "meerkat: $_MA_DIR was removed — defaulting to REJECT (commit aborted)." >&2
        exit 2
      fi
      if ! _ma_start_server "$self" "$@"; then
        # Another caller started one first.
        [[ -L "$_MA_LINK" || -e "$_MA_LINK" ]] && continue
        # Otherwise every retry fails the same way, without pause.
        echo "meerkat: could not create $_MA_DIR — defaulting to REJECT (commit aborted)." >&2
        exit 2
      fi
    elif ! _ma_server_alive; then
      _ma_bury_server
      continue
    fi

    # A reattaching caller skips the log so far: the attach stream sends
    # it the banner.
    if ((!_MA_OWNED)); then
      _MA_OWNED=1
      _MA_HELD=0
      _MA_OFFSET=$(_ma_log_size)
      _MA_PREV_CALLER="$(cat "$_MA_DIR/caller" 2>/dev/null)"
      _ma_write_caller
    fi
    _ma_relay_log

    if [[ -f "$_MA_DIR/port" ]]; then
      _ma_attach
    else
      _ma_exit_if_orphaned
      sleep 0.2
    fi
  done
}

# Record every process above the caller, from its parent up to pid 1, so
# _ma_exit_if_orphaned can detect when one exits.
_ma_record_ancestors() {
  local pid=$PPID
  _MA_ANCESTORS=()
  while ((pid > 1)); do
    _MA_ANCESTORS+=("$pid")
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -n "$pid" ]] || break
  done
}

# A killed git commit can leave its hook (and this caller) running and attached.
# It would then receive the decision and print it where nobody can read it, so
# exit once any recorded ancestor exits and leave the decision held for the next
# invocation. Check at most once a second (every fifth 0.2 s tick).
_ma_exit_if_orphaned() {
  ((_MA_TICK++ % 5 == 0)) || return 0
  local pid
  for pid in ${_MA_ANCESTORS[@]+"${_MA_ANCESTORS[@]}"}; do
    _ma_alive "$pid" && continue
    _ma_still_open "the process that ran meerkat exited"
    exit 1
  done
  return 0
}

# Whether process $1 exists. kill -0 is a shell builtin: forking ps for
# this every second cost a waiting caller about 0.06 CPU-s a second. It
# fails with "Operation not permitted" for a live process this caller may
# not signal, such as launchd or a terminal's root-owned login process, or
# any process when a sandbox denies signals; only those fork, to read the
# error. Any other error means the process is gone.
_ma_alive() {
  kill -0 "$1" 2>/dev/null && return 0
  [[ "$(LC_ALL=C kill -0 "$1" 2>&1)" == *"Operation not permitted"* ]]
}

# Whether ps can see processes at all: it lists this caller.
_ma_ps_works() {
  [[ -n "$(ps -o pid= -p $$ 2>/dev/null)" ]]
}

# A caller stopped before the decision says the review lives on, so whoever
# ran it learns to rerun instead of reading only an exit status. It then dies
# of the signal, as it would have untrapped.
_ma_stopped() {
  _ma_still_open "stopped waiting (SIG$1)"
  trap - "$1"
  kill -s "$1" $$
}

_ma_still_open() {
  # A trap can run during `IFS= read`, whose empty IFS would keep the port
  # file's fields together.
  local IFS=$' \t\n' port beam at=""
  # No port while a BEAM starts; the review is still open then too.
  read -r port beam 2>/dev/null <"$_MA_DIR/port" && at=" at http://127.0.0.1:$port/"
  echo "meerkat: $1 before the review completed. The review is still open$at; run the same command again to wait for its outcome." >&2
}

_ma_log_size() {
  if [[ -f "$_MA_DIR/log" ]]; then wc -c <"$_MA_DIR/log" | tr -d ' '; else echo 0; fi
}

_ma_relay_log() {
  local size
  size=$(_ma_log_size)
  if ((size > _MA_OFFSET)); then
    tail -c +$((_MA_OFFSET + 1)) "$_MA_DIR/log" | head -c $((size - _MA_OFFSET)) >&2
    _MA_OFFSET=$size
  fi
}

# Set _MA_DIR to the run dir the key currently names and succeed, or to
# "" and succeed when it names none, so the loop starts one.
# Drop a symlink whose target dir is gone and fail so the loop looks again.
# A real dir is an older meerkat's run: still use it because an orphaned
# review lives until reattached and can outlast an upgrade.
_ma_find_server() {
  _MA_DIR=""
  if [[ -L "$_MA_LINK" ]]; then
    local target
    target="$(readlink "$_MA_LINK")" || return 1
    _MA_DIR="${_MA_LINK%/*}/$target"
    [[ -n "$target" && -d "$_MA_DIR" ]] && return 0
    _ma_must _ma_retire "$_MA_DIR"
    return 1
  elif [[ -d "$_MA_LINK" ]]; then
    _MA_DIR="$_MA_LINK"
  fi
}

# Drop the key's symlink if it still names the given run dir; for an
# old-layout real dir, delete the dir itself. Fail only when the runs dir
# cannot be changed. Read first, so the usual case, a link already
# repointed, is never touched. Then rename the link to a name private to
# this invocation, so only one invocation drops it, and check it again:
# if another invocation repointed it meanwhile, put it back unless a
# newer link has already taken its place.
_ma_retire() {
  if [[ "$1" == "$_MA_LINK" ]]; then
    rm -rf "$1" 2>/dev/null
    return
  fi
  local name="${1##*/}" held="$_MA_LINK.retiring.$_MA_RUN" target
  [[ "$(readlink "$_MA_LINK" 2>/dev/null)" == "$name" ]] || return 0
  if ! mv "$_MA_LINK" "$held" 2>/dev/null; then
    [[ "$(readlink "$_MA_LINK" 2>/dev/null)" != "$name" ]]
    return
  fi
  if [[ ! -L "$held" ]]; then
    # An older meerkat made a real dir there in between: give it back.
    mv "$held" "$_MA_LINK" 2>/dev/null
    return 0
  fi
  target="$(readlink "$held")"
  [[ -n "$target" && "$target" != "$name" ]] && ln -sn "$target" "$_MA_LINK" 2>/dev/null
  rm -f "$held"
}

# Remove the run in _MA_DIR: the key's symlink if it still names it, and
# the run dir itself.
_ma_remove_run() {
  _ma_retire "$_MA_DIR"
  rm -rf "$_MA_DIR" 2>/dev/null && [[ ! -e "$_MA_DIR" ]]
}

# Run a change to the runs dir, failing closed if it cannot be made:
# retrying it would spin, and going on with a run half removed would
# misread it. Its own errors are dropped for this one message.
_ma_must() {
  "$@" 2>/dev/null && return
  echo "meerkat: could not update ${_MA_LINK%/*} — defaulting to REJECT (commit aborted)." >&2
  exit 2
}

# Write a pid, this caller's by default, to the run's `caller` file,
# atomically: a reader seeing it empty would take the caller for dead.
_ma_write_caller() {
  echo "${1:-$$}" >"$_MA_DIR/caller.$$" && mv -f "$_MA_DIR/caller.$$" "$_MA_DIR/caller"
}

# A reattach the server refused, or whose server exited before it heard
# from it, records again the caller it would have replaced, which may
# still wait on the run. A caller displaced by a later one does nothing:
# the file no longer names it.
_ma_restore_caller() {
  [[ -n "$_MA_PREV_CALLER" && "$(cat "$_MA_DIR/caller" 2>/dev/null)" == "$$" ]] || return 0
  _ma_write_caller "$_MA_PREV_CALLER"
}

# Once at invocation start, delete this key's finished run dirs whose
# caller is not alive or whose exit file is over a minute old.
# The minute limit covers callers ps cannot check, where it is denied,
# and a reused pid that passes the command check.
_ma_reap_finished() {
  local dir
  for dir in "$_MA_LINK".*/; do
    dir="${dir%/}"
    [[ -L "$dir" || ! -f "$dir/exit" ]] && continue
    if ! _ma_caller_alive "$dir" || _ma_exit_stale "$dir"; then
      _ma_must rm -rf "$dir"
    fi
  done
}

# True once the run dir's exit file is over a minute old. This gives
# the attached caller time to read its exit code: it polls every 0.2 s,
# so a minute is far beyond its normal delay.
_ma_exit_stale() {
  [[ -n "$(find "$1/exit" -mmin +1 2>/dev/null)" ]]
}

# True if DIR/caller names a live process whose command contains "meerkat".
# The command check stops a reused pid from passing for the caller. Where ps
# cannot tell, assume the caller lives: its run is then reaped once its exit
# file is stale, rather than taken from a caller still reading it.
_ma_caller_alive() {
  local pid
  pid="$(cat "$1/caller" 2>/dev/null)" || return 1
  [[ -n "$pid" ]] || return 1
  _ma_ps_works || return 0
  _ma_runs_meerkat "$pid"
}

# Whether ps shows pid $1 running meerkat: a reused pid runs something else.
_ma_runs_meerkat() {
  [[ "$(ps -p "$1" -o command= 2>/dev/null)" == *[Mm]eerkat* ]]
}

_ma_start_server() {
  local self="$1"
  shift
  _MA_DIR="$_MA_LINK.$(uuidgen)"
  mkdir "$_MA_DIR" 2>/dev/null || return 1
  # Written before the link makes the run findable, so a reattach finds
  # them in place.
  uuidgen >"$_MA_DIR/token"
  _ma_write_caller
  if ! ln -sn "${_MA_DIR##*/}" "$_MA_LINK" 2>/dev/null; then
    rm -rf "$_MA_DIR"
    return 1
  fi
  _MA_OWNED=1
  _MA_HELD=1
  _MA_OFFSET=0
  _MA_PID_WAIT=0
  # fork + setsid take the backend out of the caller's process group and
  # session, so a signal to the caller's whole tree (the app that ran it
  # restarting) leaves the review running.
  MEERKAT_SERVE_DIR="$_MA_DIR" \
    MEERKAT_SERVE_TOKEN="$(<"$_MA_DIR/token")" \
    MEERKAT_RUN_ID="$_MA_RUN" \
    perl -MPOSIX -e '
      my $dir = shift;
      exit 0 if fork;
      POSIX::setsid();
      open(my $f, ">", "$dir/pid.tmp") or die "meerkat: $dir/pid: $!";
      print $f "$$\n";
      close($f);
      rename("$dir/pid.tmp", "$dir/pid");
      exec(@ARGV) or die "meerkat: exec $ARGV[0]: $!";
    ' "$_MA_DIR" "$self" "$@" </dev/null >>"$_MA_DIR/log" 2>&1
}

_ma_server_alive() {
  # The detached child writes `pid` after the fork returns here.
  if [[ ! -f "$_MA_DIR/pid" ]]; then
    ((_MA_PID_WAIT++ < 50))
    return
  fi
  local pid
  pid="$(<"$_MA_DIR/pid")"
  kill -0 "$pid" 2>/dev/null || return 1
  [[ -f "$_MA_DIR/exit" ]] && return 0
  # The command check stops a reused pid passing for the backend. Where ps
  # cannot tell, the live pid is all there is to go on.
  _ma_ps_works || return 0
  _ma_runs_meerkat "$pid"
}

_ma_bury_server() {
  # It exited cleanly after the loop's exit check; the next pass collects
  # the exit code.
  [[ -f "$_MA_DIR/exit" ]] && return
  if [[ -f "$_MA_DIR/port" ]]; then
    local port beam
    read -r port beam <"$_MA_DIR/port"
    # A BEAM whose shepherd died still holds the review's port.
    if [[ -n "$beam" ]] && _ma_runs_meerkat "$beam"; then
      kill -9 "$beam" 2>/dev/null
    fi
  fi
  if ((_MA_OWNED)); then
    _ma_relay_log
    echo "meerkat: the review backend died without a decision — defaulting to REJECT (commit aborted)." >&2
    _ma_must _ma_remove_run
    exit 2
  fi
  _ma_must _ma_remove_run
}

_ma_wait_for_exit() {
  local i
  for ((i = 0; i < 150; i++)); do
    # A deleted run dir never gets its exit file.
    [[ -d "$_MA_DIR" && ! -f "$_MA_DIR/exit" ]] || return 0
    _ma_server_alive || return 0
    sleep 0.2
  done
}

_ma_request() {
  local method="$1" path="$2"
  shift 2
  curl -sS -X "$method" -H "x-meerkat-token: $_MA_TOKEN" \
    "http://127.0.0.1:$_MA_PORT/api/$path" "$@"
}

_ma_attach() {
  local fd code="" status="" line="" part beam
  # Cache these for every request, including the attach/delivered
  # acknowledgement sent after the decision: the run dir may have
  # been deleted by then, so rereading its files would fail and leave
  # the backend running.
  read -r _MA_PORT beam <"$_MA_DIR/port"
  _MA_TOKEN="$(<"$_MA_DIR/token")"
  # Through a pipe, a killed caller's curl dies on its next write, and the
  # backend sees the caller gone. Output to a file keeps curl alive.
  # Send the index git named for this invocation: `git commit -a` and
  # `git commit <path>` commit from a temporary one, and a backend that
  # reviewed a different index is not reviewing this commit.
  exec {fd}< <(_ma_request GET "attach?run=$_MA_RUN&quiet=$_MA_QUIET" \
    -G --data-urlencode "index=${GIT_INDEX_FILE:-}" -N -w 's %{http_code}\n' 2>/dev/null)

  while true; do
    if IFS= read -r -t 0.2 part <&"$fd"; then
      line+="$part"
      # Relay server stderr since the last relay before banner frames, preserving
      # main's warning-before-banner order.
      [[ "$line" == [on]" "* ]] && _ma_relay_log
      case "$line" in
        "o "*) printf '%s\n' "${line:2}" >&2 ;;
        "n "*) printf '%s' "${line:2}" >&2 ;;
        "x "*)
          code="${line:2}"
          _MA_HELD=1
          # The outcome is printed: a signal now just ends the caller.
          trap - TERM INT HUP
          ;;
        "s "*) status="${line:2}" ;;
        # Keep for older backends that send bare d; an orphaned review lives
        # until reattached, so the backend can outlast an upgrade.
        d)
          exec {fd}<&-
          echo "meerkat: a later invocation of this review took it over — aborting." >&2
          exit 1
          ;;
        "d "*)
          exec {fd}<&-
          _ma_restore_caller
          printf '%s\n' "${line:2}" >&2
          exit 1
          ;;
      esac
      # A reattach after a BEAM restart must not print the banner again.
      [[ "$line" == [on]" "* ]] && _MA_QUIET=1 && _MA_HELD=1
      line=""
    elif (($? > 128)); then
      # A read that timed out returns the partial line it got.
      line+="$part"
      _ma_relay_log
      _ma_exit_if_orphaned
    else
      break
    fi
  done
  exec {fd}<&-

  if [[ -n "$code" ]]; then
    _ma_request POST "attach/delivered?run=$_MA_RUN" -o /dev/null 2>/dev/null
    _ma_wait_for_exit
    _ma_relay_log
    _ma_remove_run
    exit "$code"
  fi

  # 409 means the review changed and 503 means another caller took delivery;
  # either way, the backend is exiting and this caller starts a fresh one.
  # 502 means this rerun could not resolve its review target or named an
  # index that no longer exists; the error was
  # printed from its o frames, the backend keeps its review, and this caller
  # exits 64, the CLI's unresolved-target exit code.
  case "$status" in
    409 | 503)
      _MA_OWNED=0
      _ma_wait_for_exit
      _ma_remove_run
      ;;
    502)
      _ma_restore_caller
      exit 64
      ;;
    *)
      sleep 0.2
      ;;
  esac
}

# The serve half: a shepherd calls this before each BEAM it starts. It
# rewrites a missing `token` or `pid`, so losing one cannot leave callers
# unable to reattach, or taking a live backend for dead.
meerkat_restore_run_files() {
  local dir="$MEERKAT_SERVE_DIR"
  if [[ ! -f "$dir/token" ]]; then
    { printf '%s\n' "$MEERKAT_SERVE_TOKEN" >"$dir/token.tmp" && mv -f "$dir/token.tmp" "$dir/token"; } 2>/dev/null || true
  fi
  if [[ ! -f "$dir/pid" ]]; then
    { echo "$$" >"$dir/pid.tmp" && mv -f "$dir/pid.tmp" "$dir/pid"; } 2>/dev/null || true
  fi
}
